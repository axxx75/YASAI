# ==========================================
# OpenRouter API Configuration
# ==========================================
OPENROUTER_API_KEY=sk-or-v1-0da...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Compatibilità con SDK OpenAI / LangChain / LiteLLM
OPENAI_API_KEY=sk-or-v1-0da...
OPENAI_API_BASE=https://openrouter.ai/api/v1

# Modello predefinito per OpenRouter (es. gratuito)
# Esempi free: meta-llama/llama-3.3-70b-instruct:free | qwen/qwen-2.5-coder-32b-instruct:free
#DEFAULT_MODEL=meta-llama/llama-3.3-70b-instruct:free
DEFAULT_MODEL=liquid/lfm-2.5-2.6b:free

# Optional: Default model via OpenRouter
AICHAT_MODEL="openrouter:anthropic/claude-3.7-sonnet"

# ==========================================
# --- Anthropic & OpenAI Standard ---
# ==========================================
#ANTHROPIC_API_KEY="sk-ant-..."
#OPENAI_API_KEY="sk-..."

# ==========================================
# --- Provider Alternativi Cloud / Redundancy ---
# ==========================================
#DEEPSEEK_API_KEY="sk-..."
#GROQ_API_KEY="gsk_..."
#OPENROUTER_API_KEY="sk-or-..."

# --- Endpoints Locali / Custom (Ollama / LiteLLM) ---
# host.docker.internal permette al container di parlare con Ollama avviato sull'host Linux/Mac/Windows
##OLLAMA_HOST="http://host.docker.internal:11434"
##OPENAI_API_BASE="http://host.docker.internal:11434/v1"

# --- Configurazione OpenClaude ---
#DEFAULT_MODEL="claude-3-7-sonnet-latest"
OPENCLAUDE_CONFIG_DIR="/home/dev/.openclaude"

CLAUDE_CODE_USE_OPENAI=1
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5-coder:7b

# ==========================================
# Se usi litellm
# ==========================================
#export OPENAI_API_BASE="http://localhost:4000"
#export OPENAI_API_KEY="sk-anything"

# ==========================================
# InstructLab (ilab) & Local Inference Configuration
# ==========================================
ILAB_REMOTE_ENDPOINT=https://openrouter.ai/api/v1
ILAB_REMOTE_API_KEY=sk-or-v1-0da...
ILAB_REMOTE_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ==========================================
# Hugging Face Token (opzionale per scaricare modelli gated)
# ==========================================
HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ==========================================
# SuperClaude / Agent Settings
# ==========================================
MCP_ATLASSIAN_TAG=v0.21.0

# ==========================================
# Memoria conversazionale del router Python
# ==========================================
YASAI_MEMORY_DB_PATH=/home/dev/.local/share/yasai/conversations.db
YASAI_MEMORY_MAX_MESSAGES=20
YASAI_MEMORY_MAX_CONTENT_CHARS=20000
# Identità stabile dell'utente locale; obbligatoria per separare le sessioni.
YASAI_MEMORY_OWNER_ID=local-user
# Le sessioni inattive oltre questo numero di giorni vengono eliminate all'avvio.
YASAI_MEMORY_RETENTION_DAYS=30
# Lascia "default" per riprendere la stessa sessione dopo un riavvio.
YASAI_SESSION_ID=default

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_AUTH_TOKEN=sk-or-v1-0da...

# ==========================================
# GitHub Authentication & Core Config
# ==========================================
GITHUB_TOKEN=ghp_I...
GITHUB_OWNER=...
GITHUB_REPO=...

# API Configuration
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT=30
GITHUB_MAX_RETRIES=3

# Optional: Configuration File Path (se usi file JSON/YAML esterni)
# GITHUB_CONFIG_PATH=config/github_config.json
